# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key (Project Settings -> API). Bypasses RLS: keep it local, personal use only.
SUPABASE_SERVICE_ROLE_KEY=
# Wikimedia asks API clients to identify themselves with contact info.
WIKI_USER_AGENT=mcp-education/0.1 (personal study tool; contact: you@example.com)
