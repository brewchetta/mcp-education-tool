# Copy to .env (stdio server) and/or .env.local (next dev). Never commit either.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# ---- Server (used by the stdio server and the /api/mcp route) ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key (Project Settings -> API). Bypasses RLS: server-side only. Mark it "Sensitive" on Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Wikimedia asks API clients to identify themselves with contact info.
WIKI_USER_AGENT=mcp-education/0.2 (personal study tool; contact: you@example.com)

# ---- Deployed HTTP server only (OAuth) ----
# UUID of YOUR Supabase user (Authentication -> Users). Only this user may use the deployed server.
OWNER_USER_ID=
# Public origin of the deployment, no trailing slash, e.g. https://my-app.vercel.app (http://localhost:3000 for next dev)
APP_URL=

# ---- Login / consent pages (public values, sent to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key. Safe to expose; the tables are locked down by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
